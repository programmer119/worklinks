FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Korean OCR is local-only. PDFs are rendered in-process and only image pages
# go through Tesseract, with a strict per-document and per-page CPU limit.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-kor tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir pyhwp pypdf six pymupdf Pillow
WORKDIR /app
CMD ["python","-u","/app/worklinks-server123-pipeline.py"]
